{
  "manifest_version": 3,
  "name": "CazaPiso: guardar anuncio",
  "version": "0.2.7",
  "description": "Lee los datos del anuncio que tienes abierto y los prepara para CazaPiso.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_title": "Guardar en CazaPiso",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
